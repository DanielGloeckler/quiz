name: Build Quizzes

on:
  push:
    branches: [ main ]
    paths:
      - 'blatt*.json'
      - 'template.html'
      - 'build.py'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Python einrichten
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: HTML Quizze erstellen
        run: python build.py

      - name: Änderungen committen und pushen
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add *.html
          git commit -m "Auto-build quiz html files [skip ci]" || echo "Keine Änderungen zum Speichern"
          git push
